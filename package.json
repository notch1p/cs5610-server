    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  }
}